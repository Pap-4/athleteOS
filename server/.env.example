# Copy to .env (git-ignored) and adjust.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://athleteos:athleteos@localhost:5432/athleteos
# Used by `npm test`. Must be a separate database: tests write real rows.
TEST_DATABASE_URL=postgresql://athleteos:athleteos@localhost:5432/athleteos_test
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
